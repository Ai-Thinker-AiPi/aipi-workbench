{
  "name": "aipi-idea-workbench",
  "version": "0.3.4",
  "description": "小安派创意工作台 · 安信可 AiPi 创意工作台（DSH 插件）：左侧硬件插件库、中间编排画布、右侧属性；把硬件插件拖进画布连线，生成逻辑并下发到底板。工作台居中，DSH 的真实会话通过右侧栏标签页并排显示。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.1.7-rc.2"
  },
  "scripts": {
    "check": "node scripts/check.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "aipi",
    "ai-thinker",
    "iot",
    "workbench"
  ],
  "author": "Ai-Thinker",
  "license": "MIT"
}
